# Local DeepSeek Harness Gateway. The Adapter intentionally accepts loopback only.
HARNESS_GATEWAY_URL=ws://127.0.0.1:32145
HARNESS_CONNECTION_TIMEOUT_SECONDS=3
HARNESS_REQUEST_TIMEOUT_SECONDS=120

# Optional overrides. Automatic Steam discovery is used when blank.
DST_GAME_DIR=
DST_STATE_FILE=
DST_REPLY_FILE=
DST_REQUEST_FILE=
DST_BRIDGE_STATUS_FILE=

# No model or speech API key belongs in this file. Configure providers in DeepSeek Harness.
