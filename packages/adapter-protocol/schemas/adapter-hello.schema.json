{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-game-harness.dev/schemas/adapter-hello.schema.json",
  "title": "AI Native Game Harness Adapter Hello",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "adapterId", "gameId", "displayName", "adapterVersion", "capabilities"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "adapterId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" },
    "gameId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" },
    "displayName": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["observation", "action", "presentation"] },
          "description": { "type": "string" },
          "requiresApproval": { "type": "boolean" },
          "inputSchema": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "object" } },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
