{
  "name": "@ai-native-game-harness/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows game edition of AI Native Game Harness.",
  "type": "module",
  "main": "src/main.mjs",
  "files": [
    "src",
    "electron-builder.config.mjs"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "cross-env AI_GAME_HARNESS_DEV=1 electron .",
    "start:demo": "cross-env AI_GAME_HARNESS_DEMO=1 electron .",
    "start:mock": "pnpm run start:demo",
    "start:dsh": "electron .",
    "pack": "cross-env NODE_OPTIONS=--max-old-space-size=12288 electron-builder --projectDir ../../.artifacts/desktop-app --config ../../apps/desktop/electron-builder.config.mjs --dir",
    "dist": "cross-env NODE_OPTIONS=--max-old-space-size=12288 electron-builder --projectDir ../../.artifacts/desktop-app --config ../../apps/desktop/electron-builder.config.mjs --win nsis"
  },
  "dependencies": {
    "@ai-native-game-harness/adapter-websocket": "workspace:*",
    "@ai-native-game-harness/game-pack": "workspace:*",
    "@ai-native-game-harness/harness-core": "workspace:*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@ai-native-game-harness/mock-game": "workspace:*",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  }
}
